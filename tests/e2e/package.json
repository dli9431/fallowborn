{
  "name": "fallowborn-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Development-only browser regression tests for Fallowborn",
  "scripts": {
    "check": "node support/check-js.js",
    "test": "npm run test:all",
    "test:all": "npm run test:server && node support/run-selected-tests.js all",
    "test:changed": "npm run test:server && node support/run-selected-tests.js changed",
    "test:chromium": "npm run test:server && playwright test --project=chromium-file --project=chromium-served",
    "test:cross-browser": "playwright test --project=firefox-served --project=webkit-served",
    "test:firefox": "playwright test --project=firefox-served",
    "test:webkit": "playwright test --project=webkit-served",
    "test:file": "playwright test --project=chromium-file",
    "test:server": "node --test support/static-server.test.js support/service-worker.test.js support/test-run-state.test.js",
    "test:served": "playwright test --project=chromium-served",
    "verify:runtime": "node support/verify-runtime-manifest.js"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
