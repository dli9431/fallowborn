# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Node (development-only Playwright dependencies live under tests/e2e)
node_modules/
npm-debug.log*
yarn-error.log*

# Playwright generated output
test-results/
playwright-report/
blob-report/
.last-tested-commit
.last-tested-commit.*
.last-test-run.json
.last-test-run.*.json

# Python bytecode (from the i18n tooling: tools/i18n_catalog.py)
__pycache__/
*.pyc

# Overpass response cache and GeoNames dumps for tools/settlement_import.py
# (re-fetchable, large)
tools/osm_overpass_cache.json
tools/geonames_cache/

# Secrets
.env
.env.*

# Deployment artifacts (itch.io zips are built from a fail-closed allowlist)
*.zip

# The Opus soundtrack under music/ is shipped and tracked. Generated source
# audio is converted and archived outside this public repository.
music/**/*.wav
music/**/*.wave
music/**/*.flac
music/**/*.mp3
music/**/*.m4a
music/**/*.aac
music/**/*.aif
music/**/*.aiff
music/**/*.wma

# Owner-local save exports and test-save fixtures. Never shipped and not part
# of the game. The parity corpus manifest (docs/plans/v2-476-phase-0) names
# paths under saves/.
saves/

# Private workspace notes must never land here. They live beside this repo,
# not in it; this guard keeps a stray copy from being committed.
notes/

# Owner-derived local stress exports; root placement makes manual import easy.
/logistics-stress-save*.txt
/logistics-stress-save*.json
